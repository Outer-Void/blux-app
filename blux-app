#!/usr/bin/env python3
"""BLUX App entrypoint (source checkout). Installed builds provide the `blux-app` console script."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from blux_app.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
